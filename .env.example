# Copy this file to .env and change the values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Notifications: set NOTIFY_BY_EMAIL=True to also email alerts.
# Without SMTP settings, emails are printed in the runserver terminal.
SITE_URL=http://127.0.0.1:8000
NOTIFY_BY_EMAIL=False
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# sqlite (default) or postgres
DB_ENGINE=sqlite
# Only used when DB_ENGINE=postgres
DB_NAME=facilitrack
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
